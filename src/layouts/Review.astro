---
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import { getCollection } from 'astro:content';
import { thumbSrcset, CARD_SIZES } from '../lib/thumbs';
import { reviewGraph } from '../lib/schema';
import { existsSync } from 'node:fs';
const { review, headings, alternate = false, slug = '' } = Astro.props;
const isRu = Astro.url.pathname.startsWith('/ru');
const locale = isRu ? 'ru-RU' : 'en-US';
const fmtDate = new Date(review.date).toLocaleDateString(locale, { year: 'numeric', month: 'long' });
const toc = (headings || []).filter((h) => h.depth === 2);
const meta = [fmtDate, review.readTime, review.extra].filter(Boolean);
const cmsEditUrl = `/admin/#/collections/reviews/entries/${slug || review.slug || ''}`;
const reviewsBase = isRu ? '/ru/reviews/' : '/reviews/';
const site = Astro.site ?? new URL('https://spykevision.com');
const canonical = new URL(Astro.url.pathname, site);
const schema = reviewGraph({ review, site, canonical, isRu });
// Phones get the 1280px hero variant (~2.5× lighter) when prebuild generated one.
// With a hero clip, the background is the clip's own poster (first frame), so nothing else
// flashes through while the video loads or restarts; the cover stays for OG/cards.
const heroPoster = review.coverVideo ? review.coverVideo.replace(/\.mp4$/, '-poster.jpg') : null;
const heroBg = heroPoster ?? review.cover;
const heroMobile = !heroPoster && review.cover && existsSync(`public/thumbs/1280${review.cover}`) ? `/thumbs/1280${review.cover}` : null;
const related = (await getCollection(isRu ? 'reviews-ru' : 'reviews'))
  .filter((r) => !r.data.draft && r.slug !== slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const t = {
  inThisReview: isRu ? 'В этом обзоре' : 'In this review',
  whatsGreat:   isRu ? 'Что понравилось' : "What's great",
  watchOut:     isRu ? 'Обратите внимание' : 'Watch out for',
  conclusion:   isRu ? 'Заключение' : 'Conclusion',
  donate:       isRu ? 'Поддержать' : 'Donate',
  subscribe:    isRu ? 'Подписаться' : 'Subscribe',
  officialPage: isRu ? 'Официальная страница →' : 'Official page →',
  subTitle:     isRu ? 'Новые обзоры на почту' : 'New reviews in your inbox',
  subLabel:     isRu ? 'Подписка на новые обзоры' : 'Get new reviews by email',
  subEmail:     isRu ? 'Ваш e-mail' : 'Your email',
  subOk:        isRu ? 'Готово! Проверьте почту и подтвердите подписку.' : 'Done! Check your inbox to confirm.',
  subBad:       isRu ? 'Проверьте адрес e-mail.' : 'Please check the email address.',
  subFail:      isRu ? 'Не получилось, попробуйте ещё раз.' : 'Something went wrong, please try again.',
  subDesc:      isRu ? 'Когда выйдет новый обзор — узнаете первыми. Без спама, отписка в один клик.' : "When a new review drops — you'll know. No spam, unsubscribe any time.",
  moreReviews:  isRu ? 'Ещё обзоры' : 'More reviews',
  allReviews:   isRu ? 'Все обзоры' : 'All reviews',
  draftTitle:   isRu ? 'Ещё не опубликовано' : 'Not published yet',
  draftText:    isRu ? 'Этот обзор пока в черновиках и не опубликован.' : "This review is still a draft and hasn't been published.",
  draftHome:    isRu ? '← На главную' : '← Back to home',
  draftBanner:  isRu ? 'Черновик — не виден посетителям' : 'Draft — not visible to visitors',
  draftEdit:    isRu ? 'Открыть в CMS →' : 'Edit in CMS →',
};
---
<Base
  title={`${review.title} | SpykeVision`}
  description={review.summary}
  active="reviews"
  type="article"
  image={review.coverCard || review.cover}
  noindex={review.draft}
  alternate={alternate}
  reviewAssets={true}
  schema={schema}
>
  <!-- Hero cover is a CSS background — preload it so LCP doesn't wait for stylesheet parse -->
  {heroBg && !heroMobile && <link slot="head" rel="preload" as="image" href={heroBg} fetchpriority="high" />}
  {heroMobile && <link slot="head" rel="preload" as="image" href={heroMobile} media="(max-width: 900px)" fetchpriority="high" />}
  {heroMobile && <link slot="head" rel="preload" as="image" href={review.cover} media="(min-width: 901px)" fetchpriority="high" />}
  {heroMobile && <style slot="head" is:inline set:html={`@media (max-width:900px){.article-hero-fb{background-image:url('${heroMobile}')!important}}`} />}
  <!-- Draft overlay: shown to non-preview visitors when article is a draft -->
  {review.draft && (
    <div id="draftOverlay" class="draft-overlay">
      <div class="draft-overlay-box">
        <div class="draft-overlay-icon">🔒</div>
        <h2>{t.draftTitle}</h2>
        <p>{t.draftText}</p>
        <a href={isRu ? '/ru/' : '/'} class="btn">{t.draftHome}</a>
      </div>
    </div>
  )}

  <!-- Draft banner: shown in preview mode when article is a draft -->
  {review.draft && (
    <div id="draftBanner" class="draft-banner" style="display:none">
      <span>{t.draftBanner}</span>
      <a href={cmsEditUrl} class="draft-banner-edit">{t.draftEdit}</a>
    </div>
  )}

  <!-- Full-bleed hero with cover image as background -->
  <div
    class={`article-hero-fb${review.cover ? '' : ' article-hero-fb--plain'}`}
    style={heroBg ? `background-image:url('${heroBg}')` : ''}
    data-draft={review.draft ? 'true' : null}
  >
    {review.coverVideo && (
      <video class="hero-video" muted playsinline preload="none" poster={heroPoster} data-src={review.coverVideo}></video>
    )}
    {review.coverVideo && (
      <script is:inline>
        // Replay the hero clip whenever the reader scrolls away from the header and comes back.
        // "Away" = the hero is less than 80 % visible; "back" = it is fully in view again.
        (function () {
          var v = document.querySelector('.hero-video');
          if (!v) return;
          // Clip loads after the page does, so it doesn't compete with first paint; poster shows meanwhile.
          window.addEventListener('load', function () {
            v.src = v.dataset.src;
            var p0 = v.play(); if (p0 && p0.catch) p0.catch(function () {});
          });
          if (!('IntersectionObserver' in window)) return;
          var armed = false;
          new IntersectionObserver(function (entries) {
            var r = entries[0].intersectionRatio;
            if (r < 0.8) { armed = true; return; }
            if (armed && r >= 0.98) {
              armed = false;
              try { v.currentTime = 0; } catch (e) {}
              var p = v.play(); if (p && p.catch) p.catch(function () {});
            }
          }, { threshold: [0, 0.2, 0.4, 0.6, 0.8, 0.98, 1] }).observe(v);
        })();
      </script>
    )}
    <div class="article-hero-overlay">
      <div class="wrap">
        {review.eyebrow && <p class="eyebrow">{review.eyebrow}</p>}
        <h1>{review.title}</h1>
        {review.summary && <p class="hero-summary">{review.summary}</p>}
        <div class="article-meta">
          <span class="author"><span class="avatar"></span>SpykeSIK</span>
          {meta.map((m) => (<><span class="meta-sep">·</span><span>{m}</span></>))}
        </div>
      </div>
    </div>
  </div>

  <main class={`wrap article-page${review.wide ? ' article-page--wide' : ''}`} data-draft={review.draft ? 'true' : null}>
    <div class="prose">
      {toc.length > 0 && (
        <nav class="toc">
          <h4>{t.inThisReview}</h4>
          {review.tocGroups ? (
            <div class="toc-grid">
              {review.tocGroups.map((group) => {
                const items = toc.filter(h => group.sections.includes(h.text));
                return items.length > 0 ? (
                  <div class="toc-group">
                    <p class="toc-group-label">{group.label}</p>
                    <ul>
                      {items.map((h) => (<li><a href={`#${h.slug}`}>{h.text}</a></li>))}
                    </ul>
                  </div>
                ) : null;
              })}
            </div>
          ) : (
            <ul>
              {toc.map((h) => (<li><a href={`#${h.slug}`}>{h.text}</a></li>))}
            </ul>
          )}
        </nav>
      )}

      <slot />

      {(review.pros.length > 0 || review.cons.length > 0) && (
        <div class="proscons" id="proscons">
          {review.pros.length > 0 && (
            <div class="pc-box pros">
              <h4>{t.whatsGreat}</h4>
              <ul>{review.pros.map((p) => (<li>{p}</li>))}</ul>
            </div>
          )}
          {review.cons.length > 0 && (
            <div class="pc-box cons">
              <h4>{t.watchOut}</h4>
              <ul>{review.cons.map((c) => (<li>{c}</li>))}</ul>
            </div>
          )}
        </div>
      )}

      {(review.verdictTitle || review.verdictText) && (
        <div class="conclusion" id="conclusion">
          <p class="conclusion-label">{t.conclusion}</p>
          {review.verdictTitle && <h3>{review.verdictTitle}</h3>}
          {review.verdictText && <p>{review.verdictText}</p>}
          <div class="conclusion-actions">
            {!review.draft && (
              <form class="sub-inline" data-ok={t.subOk} data-bad={t.subBad} data-fail={t.subFail} novalidate>
                <span class="sub-label">{t.subLabel}</span>
                <input type="email" name="email" placeholder={t.subEmail} aria-label={t.subEmail} autocomplete="email" required />
                <input type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" class="sub-hp" />
                <button type="submit" class="btn-donate">{t.subscribe}</button>
                <p class="sub-msg" role="status"></p>
              </form>
            )}
            {review.buyLink && (
              <a href={review.buyLink} target="_blank" rel="noopener" class="btn btn-official">
                {t.officialPage}
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </main>

  {!review.draft && related.length > 0 && (
    <section class="section wrap related-reviews">
      <div class="section-head"><h2>{t.moreReviews}</h2><a href={reviewsBase}>{t.allReviews}</a></div>
      <div class="grid">
        {related.map((r) => (
          <a href={`${reviewsBase}${r.slug}/`} class="card">
            <div class="card-media">
              <img src={r.data.coverCard || r.data.cover} alt={r.data.title} loading="lazy" decoding="async" srcset={thumbSrcset(r.data.coverCard || r.data.cover)} sizes={CARD_SIZES} />
              {r.data.badge && <div class="card-badge">{r.data.badge}</div>}
            </div>
            <div class="card-body">
              {r.data.category && <span class="card-cat">{r.data.category}</span>}
              <h3>{r.data.title}</h3>
              <p>{r.data.summary}</p>
              <div class="card-meta">
                <span class="author"><span class="avatar"></span>SpykeSIK</span>
                <span>•</span><span>{new Date(r.data.date).toLocaleDateString(locale, { year: 'numeric', month: 'short' })}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {!review.draft && <Comments title={review.title} />}

  <script is:inline>
  document.querySelectorAll('.sub-inline').forEach(function (f) {
    var msg = f.querySelector('.sub-msg'), btn = f.querySelector('button');
    function say(text, ok) { msg.textContent = text; msg.className = 'sub-msg ' + (ok ? 'ok' : 'err'); }
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = f.email.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return say(f.dataset.bad, false);
      btn.disabled = true;
      fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, hp: f.hp.value }) })
        .then(function (r) { return r.json().then(function (d) { return [r.ok, d]; }); })
        .then(function (res) {
          if (res[0] && res[1].ok) { say(f.dataset.ok, true); f.email.value = ''; }
          else say(res[1].error === 'invalid' ? f.dataset.bad : f.dataset.fail, false);
        })
        .catch(function () { say(f.dataset.fail, false); })
        .then(function () { btn.disabled = false; });
    });
  });
  </script>
</Base>
