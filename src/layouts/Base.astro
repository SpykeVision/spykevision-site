---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Donate from '../components/Donate.astro';
import { v } from '../lib/assetVersion';
const {
  title, description, active, theme = 'light',
  image,            // og:image — site-relative path (e.g. review cover)
  type = 'website', // og:type
  alternate = false, // true when an EN↔RU counterpart page exists at the mirrored path
  noindex = false,
  reviewAssets = false, // Chart.js, comparison sliders and review widget scripts — only review pages need them
} = Astro.props;
const isRu = Astro.url.pathname === '/ru' || Astro.url.pathname.startsWith('/ru/');
const site = Astro.site ?? new URL('https://spykevision.com');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = image ? new URL(image, site) : null;
const enPath = isRu ? (Astro.url.pathname.replace(/^\/ru\/?/, '/') || '/') : Astro.url.pathname;
const ruPath = isRu ? Astro.url.pathname : (Astro.url.pathname === '/' ? '/ru/' : '/ru' + Astro.url.pathname);
---
<!DOCTYPE html>
<html lang={isRu ? 'ru' : 'en'} data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {alternate && (
    <>
      <link rel="alternate" hreflang="en" href={new URL(enPath, site)} />
      <link rel="alternate" hreflang="ru" href={new URL(ruPath, site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(enPath, site)} />
    </>
  )}
  <meta property="og:site_name" content="SpykeVision" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={isRu ? 'ru_RU' : 'en_US'} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Apply stored theme before first paint to avoid a light-theme flash -->
  <script is:inline>try{var t=localStorage.getItem('sv-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}</script>
  <slot name="head" />
  <link rel="stylesheet" href={v("/css/style.css")} />
  <link rel="alternate" type="application/rss+xml" title="SpykeVision Reviews" href="/rss.xml" />
  {reviewAssets && (
    <>
      <!-- Before/after comparison slider (web component) -->
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/styles.css" />
      <script type="module" src="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/index.js"></script>
      <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
      <script is:inline src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2/dist/chartjs-plugin-datalabels.min.js"></script>
    </>
  )}
</head>
<body>
  <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
    <span class="theme-icon">☀️</span>
    <span class="theme-label">Light</span>
  </button>

  <Header active={active} />

  <slot />

  <Footer />

  <Donate />

  <button class="scroll-top" id="scrollTop" aria-label="Back to top">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
  </button>
  <button class="scroll-bottom" id="scrollBottom" aria-label="Go to bottom">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  </button>

  <script is:inline src={v("/js/main.js")}></script>
  {reviewAssets && (
    <>
      <script is:inline src={v("/js/compare.js")}></script>
      <script is:inline src={v("/js/charts-tnm.js")}></script>
      <script is:inline src={v("/js/charts-tnm-cards.js")}></script>
      <script is:inline src={v("/js/enh-compare.js")}></script>
    </>
  )}
  <script is:inline defer src={v("/js/metrics.js")}></script>
  <!-- Cloudflare Web Analytics --><script is:inline defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "92363d386413401286d548d138515fea"}'></script><!-- End Cloudflare Web Analytics -->
</body>
</html>
