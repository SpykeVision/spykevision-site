---
import { getCollection } from 'astro:content';
import Review from '../../layouts/Review.astro';

export async function getStaticPaths() {
  // Build all slugs including drafts — draft pages are gated client-side.
  const reviews = await getCollection('reviews');
  return reviews.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
// hreflang only when the RU twin exists at the mirrored URL
const hasRu = (await getCollection('reviews-ru')).some((r) => r.slug === entry.slug);
---
<Review review={entry.data} slug={entry.slug} headings={headings} alternate={hasRu}>
  <Content />
</Review>
