---
import { getCollection } from 'astro:content';
import Review from '../../../layouts/Review.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews-ru');
  return reviews.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
// hreflang only when the EN twin exists at the mirrored URL
const hasEn = (await getCollection('reviews')).some((r) => r.slug === entry.slug);
---
<Review review={entry.data} slug={entry.slug} headings={headings} lang="ru" alternate={hasEn}>
  <Content />
</Review>
