---
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getCollection } from 'astro:content';
import { thumbSrcset, CARD_SIZES } from '../../lib/thumbs';
import home from '../../data/home.ru.json';

const reviews = (await getCollection('reviews-ru'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const ogCover = reviews.find((r) => !r.data.draft)?.data.cover;
---
<Base
  title={home.meta.title}
  description={home.meta.description}
  active="reviews"
  image={ogCover}
  alternate={true}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <h1>{home.hero.heading}</h1>
      <p>{home.hero.text}</p>
      <a href="/ru/reviews/" class="btn">{home.hero.ctaLabel}</a>
    </div>
  </section>

  <main class="wrap">
    {reviews.length > 0 && (
      <section class="section" id="reviews">
        <div class="section-head"><h2>{home.headings.latest}</h2><a href="/ru/reviews/">{home.headings.allReviews}</a></div>
        <div class="grid">
          {reviews.slice(0, 6).map((r, i) => (
            <a href={`/ru/reviews/${r.slug}/`} class="card" data-draft={r.data.draft ? 'true' : null}>
              <div class="card-media">
                <img src={r.data.coverCard || r.data.cover} alt={r.data.title} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i === 0 ? 'high' : undefined} srcset={thumbSrcset(r.data.coverCard || r.data.cover)} sizes={CARD_SIZES} />
                {r.data.badge && <div class="card-badge">{r.data.badge}</div>}
              </div>
              <div class="card-body">
                {r.data.draft && <span class="draft-badge">Черновик</span>}
                {r.data.category && <span class="card-cat">{r.data.category}</span>}
                <h3>{r.data.title}</h3>
                <p>{r.data.summary}</p>
                <div class="card-meta">
                  <span class="author"><span class="avatar"></span>SpykeSIK</span>
                  <span>•</span><span>{new Date(r.data.date).toLocaleDateString('ru-RU',{year:'numeric',month:'short'})}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section" id="coming-soon">
      <div class="section-head"><h2>{home.headings.comingSoon}</h2></div>
      <div class="cs-list">
        {home.comingSoon.map((c) => (
          <a href="#" class="cs-card">
            <div class="cs-media">
              {c.image && <img src={c.image} alt={c.title} class="cs-img" loading="lazy" decoding="async" srcset={thumbSrcset(c.image)} sizes={CARD_SIZES} />}
              <div class={/progress|процесс|тестир/i.test(c.status) ? "cs-badge cs-badge--progress" : "cs-badge"}>{c.status}</div>
            </div>
            <div class="cs-body">
              <span class="card-cat">{c.category}</span>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
              <div class="card-meta">
                <span class="author"><span class="avatar"></span>SpykeSIK</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="measurements">
      <div class="section-head"><h2>{home.headings.why}</h2></div>
      <div class="grid">
        {home.whyCards.map((c) => (
          <div class="card"><div class="card-body">
            <span class="card-cat" style={`color:var(--${c.color})`}>{c.tag}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div></div>
        ))}
      </div>
    </section>
  </main>

  <Subscribe lang="ru" />
</Base>
